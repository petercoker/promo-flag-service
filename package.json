{
  "name": "promo-flag-service",
  "version": "1.0.0",
  "description": "An orchestration & circuit-breaking feature flag service built to isolate blast radiuses and protect core storefront transaction flows during high-scale e-commerce promotions.",
  "main": "dist/src/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/src/index.js",
    "build": "tsc",
    "prebuild": "npm run typecheck",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run tests/evaluator.test.ts",
    "test:integration": "vitest run tests/integration.test.ts",
    "check": "npm run typecheck && npm run test",
    "check:imports": "node --check scripts/check-imports.js",
    "validate": "npm run typecheck && npm run check:imports && npm run test",
    "clean": "rm -rf dist/"
  },
  "keywords": [
    "feature-flags",
    "graphql",
    "typescript",
    "apollo-server",
    "promo-engineering"
  ],
  "author": "peter-coker",
  "license": "ISC",
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "tsx": "^4.20.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "graphql": "^16.14.2"
  }
}
